{
  "name": "@viafoura/sdk-react-native",
  "version": "0.1.16",
  "viafoura": {
    "iosSdkVersion": "1.3.8"
  },
  "description": "Viafoura React Native SDK",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build",
    "fetch:ios-framework": "node scripts/fetch-ios-framework.js",
    "lint": "eslint src",
    "test": "echo \"no tests\" && exit 0",
    "prepare": "npm run build && npm run fetch:ios-framework",
    "prepack": "npm run fetch:ios-framework"
  },
  "keywords": [
    "react-native",
    "expo",
    "viafoura-sdk",
    "Viafoura"
  ],
  "repository": "https://github.com/viafoura/sdk-react-native-core",
  "bugs": {
    "url": "https://github.com/viafoura/sdk-react-native-core/issues"
  },
  "author": "Viafoura <support@viafoura.com> ()",
  "license": "MIT",
  "homepage": "https://github.com/viafoura/sdk-react-native-core#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build",
    "ios",
    "android",
    "Viafoura.podspec",
    "react-native.config.js",
    "README.md",
    "package.json"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/react": "~19.1.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  }
